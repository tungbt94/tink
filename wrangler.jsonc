{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tink",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "tink.tung.ai.vn", "custom_domain": true }],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tink",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
