{
  "name": "tink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:web && cf dev",
    "dev:web": "pnpm -C web dev",
    "build:web": "pnpm -C web build",
    "deploy": "pnpm build:web && cf deploy",
    "postinstall": "pnpm -C web install",
    "typecheck": "cf workers types && tsc --noEmit",
    "test": "pnpm build:web && vitest run"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "cf": "1.0.0-beta.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  }
}
